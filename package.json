{
  "name": "s-app-scoder-agent",
  "version": "0.8.7",
  "description": "Autonomous coding agent CLI — writes, edits, and builds code autonomously until the project compiles without errors.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scoder": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "coverage": "npm run build && node --test --experimental-test-coverage test/*.test.mjs",
    "eval": "node test/run-eval.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/run-e2e.mjs && node test/run-mcp-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "nbhson",
  "keywords": [
    "cli",
    "agent",
    "ai",
    "coding-agent",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbhson/app-scoder-agent.git"
  },
  "homepage": "https://github.com/nbhson/app-scoder-agent#readme",
  "bugs": "https://github.com/nbhson/app-scoder-agent/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".scoderrc.example.json"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "gpt-tokenizer": "^4.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1"
  }
}
