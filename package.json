{
  "name": "s-app-scoder-agent",
  "version": "0.3.2",
  "description": "Autonomous coding agent CLI - similar to opencode/cline/claude. Runs tasks until build succeeds.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scoder": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "coverage": "npm run build && node --test --experimental-test-coverage test/*.test.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/run-e2e.mjs && node test/run-mcp-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "coding-agent",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbhson/app-scoder-agent.git"
  },
  "homepage": "https://github.com/nbhson/app-scoder-agent#readme",
  "bugs": "https://github.com/nbhson/app-scoder-agent/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
